SASS_PATH=node_modules:src
VITE_APP_API_URL=http://localhost:8001/v1
# Helsinki Tunnistamo (legacy)
VITE_OPENID_CONNECT_CLIENT_ID=mvj-public-ui
VITE_OPENID_CONNECT_API_TOKEN_KEY=http://tunnistamo-backend:8000/mvj
VITE_OPENID_CONNECT_API_TOKEN_URL=http://tunnistamo-backend:8000/api-tokens/
VITE_OPENID_CONNECT_AUTHORITY_URL=http://tunnistamo-backend:8000/openid/
VITE_OPENID_CONNECT_SCOPE=openid profile http://tunnistamo-backend:8000/mvj
# Helsinki Tunnistus
VITE_TUNNISTUS_OIDC_CLIENT_ID=mvj-ui-dev
VITE_TUNNISTUS_OIDC_AUTHORITY_URL=https://tunnistus.test.hel.ninja/auth/realms/helsinki-tunnistus
VITE_TUNNISTUS_OIDC_API_TOKEN_URL=https://tunnistus.test.hel.ninja/auth/realms/helsinki-tunnistus/protocol/openid-connect/token
VITE_TUNNISTUS_OIDC_SCOPE=openid profile
VITE_TUNNISTUS_OIDC_API_AUDIENCE=mvj-api-dev
# Use legacy Tunnistamo SSO, or Tunnistus SSO?
# Options: "tunnistamo", "tunnistus"
VITE_OIDC_PROVIDER=tunnistus
